# Leave unset to proxy /api/v1/* through this Next.js server to the API on the
# same machine (the default). Set it to point the browser straight at an API
# elsewhere -- but only if that API is reachable *from the browser*, and note
# that a browser cannot reach a container's localhost.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Where this Next.js server proxies /api/v1/* when NEXT_PUBLIC_API_URL is unset.
# API_PROXY_TARGET=http://127.0.0.1:8000
